project_id = "your-gcp-project-id"
# Use Application Default Credentials or Workload Identity Federation (no credentials_file).
region      = "us-central1"
zone        = "us-central1-a"
environment = "pilot"
detector    = "noop"

# Prefer digest-pinned images from ./scripts/build_gcp_images.sh:
# api_image    = "us-central1-docker.pkg.dev/PROJECT/akshrava/akshrava-api@sha256:..."
# worker_image = "us-central1-docker.pkg.dev/PROJECT/akshrava/akshrava-worker@sha256:..."

# REQUIRED for worn-phone WSS: either grant an edge invoker, or temporarily open public invoke.
# Empty invokers + api_allow_unauthenticated=false fails terraform plan (phones cannot reach Cloud Run).
api_invoker_members = ["serviceAccount:edge@PROJECT.iam.gserviceaccount.com"]
# Temporary public pilot edge only (discouraged):
# api_allow_unauthenticated = true

# Memorystore in-transit TLS (rediss:// URLs). Requires redis_tier = "STANDARD_HA".
# redis_transit_encryption = true

# --- Availability controls (defaults are the SAFE values; opt OUT deliberately) ---
# Redis backs session admission, frame rate limiting and worker replay protection: losing it
# ends assistance for every connected phone, so the default is a failover pair.
# redis_tier = "STANDARD_HA"   # "BASIC" is single-node, development-only
#
# Cloud SQL: REGIONAL keeps a synchronous standby in a second zone. ZONAL makes a zone event
# fail /readyz and remove every API instance from service.
# database_availability_type = "REGIONAL"   # "ZONAL" is development-only
#
# Worker: a single VM is a fleet-wide SPOF for the whole vision path.
# enable_worker_ha = true

# External PKI is the default (manage_pki_in_terraform=false).
# Place PEMs under cloud/gcp/pki/ (gitignored). tls.tf loads them via file("${path.module}/pki/...").
# Do NOT use file() inside .tfvars — Terraform forbids function calls there.
manage_pki_in_terraform = false
# Optional overrides (empty → cloud/gcp/pki/*.pem):
# jwt_public_key_pem = "-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# Bootstrap-only (keys land in TF state — rotate if state is copied):
# manage_pki_in_terraform = true

# When ready for GPU inference:
# detector            = "remote"
# yolo_weights_sha256 = "hex64..."
