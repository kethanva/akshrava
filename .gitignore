**/build/
# SwiftPM writes .build/ (dot-prefixed), which **/build/ above does NOT match. Without this the
# 80+ MB module cache under ios/Akshrava/.build lands in the first commit that adds ios/.
**/.build/
# Xcode: the project is generated from ios/AkshravaApp/project.yml by xcodegen, never committed.
ios/AkshravaApp.xcodeproj/
ios/*.xcodeproj/
